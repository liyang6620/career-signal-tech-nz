ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://career_signal:career_signal@localhost:5432/career_signal
CORS_ORIGINS=http://localhost:5173
# Optional. Deterministic scoring and local development do not require OpenAI.
OPENAI_API_KEY=
# Generate a high-entropy secret for every deployed environment.
JWT_SECRET=development-only-change-me-at-least-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:5173
# Required in production. Development logs email content to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=career-signal-private
STORAGE_ACCESS_KEY=career-signal
STORAGE_SECRET_KEY=development-storage-secret
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
UPLOAD_MAX_BYTES=10485760
INGESTION_API_KEY=development-ingestion-key

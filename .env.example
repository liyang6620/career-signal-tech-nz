ENVIRONMENT=development
POSTGRES_DB=career_signal
POSTGRES_USER=career_signal
POSTGRES_PASSWORD=
# Used only when running the backend outside Compose. URL-encode special characters.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
# Optional. Deterministic scoring and local development do not require OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=900
# semantic uses BAAI/bge-small-en; hash is only for offline tests
EMBEDDING_MODE=semantic
# Generate a high-entropy secret for every deployed environment.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:5173
# Required in production. Development logs email content to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=career-signal-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# trusted_demo skips malware scanning and is only for controlled portfolio files.
MALWARE_SCAN_MODE=clamav
UPLOAD_MAX_BYTES=10485760
INGESTION_API_KEY=

# Compose publishes only these loopback-bound development ports.
API_HOST_PORT=8001
STORAGE_HOST_PORT=9000
STORAGE_CONSOLE_HOST_PORT=9001
